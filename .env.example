# Copy to .env (not committed) or set these in your host's dashboard.
# Railway: set them under Service → Variables. Nothing in this file is
# required on a development machine — the defaults below are what runs
# locally.

# Port and interface. The platform assigns the port in production
# (Railway sets PORT, typically 8080); the server binds 0.0.0.0 so the
# platform's HTTPS proxy can reach it.
PORT=8080
HOST=0.0.0.0

# Persistent database location. Point this at a mounted, persistent disk
# in production. Railway: mount a volume at /var/data and the app uses it
# automatically (Railway exposes RAILWAY_VOLUME_MOUNT_PATH); setting
# NT_DATA_DIR=/var/data does the same thing explicitly. NT_DB_FILE, when
# set, is the full path to the database file and wins over both.
# Defaults to server/data when unset, which is fine for local development.
NT_DATA_DIR=/var/data

# First-run administrator password. A random one is generated and printed
# once in the server log when this is not set. It must be changed on the
# first-run screen (/admin/first-run.html) before the admin area unlocks.
NT_ADMIN_PASSWORD=

# Set to 1 to refuse to boot when the database would live inside the
# deploy directory (recommended in production).
NT_REQUIRE_PERSISTENT_STORAGE=1

# Administrator session lifetime in days (default 7, capped at 365).
NT_SESSION_DAYS=7

# Secure session cookie. Unset = mark the cookie Secure whenever the
# request arrives over HTTPS (directly or through the platform's
# X-Forwarded-Proto header, which Railway sends). 1 = always, 0 = never
# (only for a local HTTP setup).
NT_COOKIE_SECURE=

# Origins allowed to call the API from another website with credentials,
# comma separated, for example https://app.example.com. Unset means the
# front end and the API share one origin, which is how the platform is
# served. "*" is deliberately refused.
NT_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# WhatsApp payments and the confirmation email
# ---------------------------------------------------------------------------
# The number students reach to agree a payment, in international format
# without "+" (wa.me style). Leave unset for the configured default.
NT_WHATSAPP_NUMBER=260764599915
NT_WHATSAPP_CONTACT=Mr Steven Manda

# Public address used for the "Redeem Access" link inside the confirmation
# email. Unset means the address the administrator's browser used to reach
# the console, which is correct on a single deployment.
NT_PUBLIC_URL=

# Outgoing email for confirmed payments. Two transports are supported.
#
# 1) SMTP (start with a plain host/port; 465 implies TLS):
#      NT_SMTP_HOST=smtp.example.com
#      NT_SMTP_PORT=587
#      NT_SMTP_USER=access@example.com
#      NT_SMTP_PASS=...
#      NT_SMTP_SECURE=1        # implicit TLS from the first byte (port 465)
#      NT_SMTP_STARTTLS=0      # only for a trusted local relay
#      NT_SMTP_ALLOW_INSECURE=1  # only for a trusted local relay
#    or in one line: NT_SMTP_URL=smtps://user:password@smtp.example.com:465
#
# 2) HTTPS relay that accepts {from,fromName,to,subject,text,html}:
#      NT_MAIL_API_URL=https://mailer.example.com/send
#      NT_MAIL_API_KEY=...
#
NT_SMTP_URL=
NT_SMTP_HOST=
NT_SMTP_PORT=
NT_SMTP_USER=
NT_SMTP_PASS=
NT_SMTP_SECURE=
NT_SMTP_STARTTLS=
NT_SMTP_ALLOW_INSECURE=
NT_MAIL_API_URL=
NT_MAIL_API_KEY=
NT_MAIL_FROM=access@nucleartutorials.zm
NT_MAIL_FROM_NAME=Nuclear Tutorials
NT_MAIL_TIMEOUT_MS=

# When email is not configured every confirmation is still stored and the
# access code is shown in Admin → Payment enquiries, where "Retry email"
# sends it once sending works. Nothing is ever lost.

# There is no setting that loads sample content in production: `npm run
# seed:demo` refuses to run when NODE_ENV=production or when the process is
# on a deployed host (Railway, Render, Heroku, Fly, Cloud Run, App Service,
# Vercel, Netlify). Use it on a development machine only.
