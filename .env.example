# Copy to .env (not committed) or set these in your host's dashboard.

# Port and interface
PORT=8000
HOST=0.0.0.0

# Persistent database location. Point this at a mounted, persistent disk
# in production (for Render: the disk mount path, e.g. /var/data).
# Defaults to server/data when unset, which is fine for local development.
NT_DATA_DIR=/var/data

# First-run administrator password. A random one is generated and printed
# once in the server log when this is not set. It must be changed in
# Admin → Settings before the catalogue can be managed.
NT_ADMIN_PASSWORD=

# Set to 1 to refuse to boot when the database would live inside the
# deploy directory (recommended in production).
NT_REQUIRE_PERSISTENT_STORAGE=1

# Development only: allow `npm run seed:demo` to load the sample
# MIT OpenCourseWare / Crash Course catalogue.
# NT_ALLOW_DEMO_SEED=1
